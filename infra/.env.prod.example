# This file is for infra/compose.yml (the self-hosted full stack: API + Postgres +
# Redis + coturn), which remaps these flat DEVICE_IDENTITY_*/etc. names to the
# ASP.NET Core DeviceIdentity__* config keys itself.
#
# It is NOT the .env format for the GitHub Actions VPS deploy (deploy/docker-compose.prod.yml,
# see docs/deployment-vps-ssh.md). That path has no remapping step: its .env must use the
# nested DeviceIdentity__* names directly, or device-identity auth fails at API startup.
COMPOSE_PROJECT_NAME=sonicrelay
COMPOSE_PROFILES=prod
ASPNETCORE_ENVIRONMENT=Production
API_PUBLIC_BASE_URL=https://stream.seudominio.com
API_IMAGE=ghcr.io/seu-user/sonicrelay-api:latest
POSTGRES_VERSION=17-alpine
POSTGRES_DB=sonicrelay
POSTGRES_USER=sonicrelay
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
REDIS_VERSION=7-alpine
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
SESSION_CODE_TTL_MINUTES=10
SESSION_MAX_VIEWERS=3
SESSION_IDLE_TIMEOUT_MINUTES=5
RATE_LIMIT_JOIN_SESSION_PER_MINUTE=10
RATE_LIMIT_CREATE_SESSION_PER_MINUTE=10
DEVICE_IDENTITY_CREDENTIAL_HMAC_KEY=CHANGE_ME_STRONG_DEVICE_CREDENTIAL_HMAC_KEY
DEVICE_IDENTITY_PAIRING_CODE_HMAC_KEY=CHANGE_ME_STRONG_PAIRING_CODE_HMAC_KEY
DEVICE_IDENTITY_TOKEN_SIGNING_KEY=CHANGE_ME_STRONG_DEVICE_TOKEN_SIGNING_KEY_32_BYTES_MIN
# --- Browser origins (CORS) ---------------------------------------------
# The Flutter web viewer calls this API cross-origin, so its origin must be
# allowed. Left empty the API allows its own published viewer
# (https://sonicrelay.hugodotnet.dev); set this to a fork's viewer instead.
# Native clients send no Origin header and ignore this entirely.
CORS_ALLOWED_ORIGIN=
# --- Data retention (issue #44) -----------------------------------------
# SonicRelay declares on Google Play that user data is deleted automatically
# within 90 days of collection. Raising MAX_DAYS above 90 makes that public
# statement false; see docs/data-retention.md before changing anything here.
DATA_RETENTION_MAX_DAYS=90
DATA_RETENTION_CLEANUP_INTERVAL_HOURS=24
DATA_RETENTION_DEVICE_ROTATION_DAYS=60
# --- TURN / ICE ---------------------------------------------------------
# TURN_PUBLIC_HOST alone is enough for the API: it derives
#   turn:<host>:3478?transport=udp, turn:<host>:3478?transport=tcp
# and stun:<host>:3478 from it. Set TURN_URIS/STUN_URIS explicitly only to
# override (e.g. to add turns:<host>:5349?transport=tcp once coturn has a
# TLS certificate mounted).
# IMPORTANT: TURN_STATIC_AUTH_SECRET must be the SAME value in the API .env
# and in the coturn .env — the API signs short-lived credentials with it and
# coturn verifies them.
TURN_PUBLIC_HOST=turn.seudominio.com
TURN_REALM=sonicrelay
TURN_STATIC_AUTH_SECRET=CHANGE_ME_STRONG_TURN_SECRET
#TURN_URIS=turn:turn.seudominio.com:3478?transport=udp,turn:turn.seudominio.com:3478?transport=tcp
#STUN_URIS=stun:turn.seudominio.com:3478
#TURN_CREDENTIAL_TTL_SECONDS=3600
# Required by deploy/docker-compose.prodcoturn.yml (host networking):
TURN_EXTERNAL_IP=203.0.113.10
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
COTURN_VERSION=latest
